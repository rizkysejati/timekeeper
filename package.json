{
  "name": "timekeeper",
  "productName": "Timekeeper",
  "version": "1.0.0",
  "description": "Timer countdown untuk debat, acara, dan panggung dengan output bersih.",
  "main": "main.js",
  "author": "Rizky Dwi Karunia Sejati",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "test": "node test/engine.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rizky.timekeeper",
    "productName": "Timekeeper",
    "files": ["main.js", "engine.js", "preload.js", "renderer/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
